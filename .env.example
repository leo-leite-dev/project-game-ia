# Obtenha em Supabase > projeto game-ia > Connect / Project Settings > API.
# Valores fictícios. Copie para .env.local e substitua apenas pelos dados públicos.
VITE_SUPABASE_URL=https://seu-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA
# Somente para projetos que ainda usam a chave pública JWT anon (em vez da acima):
# VITE_SUPABASE_ANON_KEY=SUBSTITUA_PELA_CHAVE_ANON_PUBLICA
# NUNCA use service_role, sb_secret_, senha do banco, SMTP ou Google Client Secret.
